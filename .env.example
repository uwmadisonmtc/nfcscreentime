# Supabase: Project Settings → API.
# Use the SERVICE ROLE key (secret), not the anon key. It only lives on the
# server; never put it in a NEXT_PUBLIC_ variable or commit it to GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# iCloud links to the two shortcuts, once you've built them (see SHORTCUTS.md).
# These are public, so NEXT_PUBLIC_ is fine here.
NEXT_PUBLIC_TOGGLE_SHORTCUT_URL=
NEXT_PUBLIC_CHECK_SHORTCUT_URL=
